#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_ARB_gpu_shader_int64 : require
#include "common/base.glsl"
void main() {
    uint id=gl_GlobalInvocationID.x;if(id>=p.count)return;
    u64vec2 v[8];[[unroll]] for(int a=0;a<8;++a) [[unroll]] for(int l=0;l<2;++l)v[a][l]=uint64_t(pattern(id+uint(a*17+l*3),p.seed));
    for(uint i=0;i<p.iterations;++i) [[unroll]] for(int a=0;a<8;++a)v[a]=v[a]*uint64_t(1664525)+u64vec2(uint64_t(1013904223u+uint(a)));
    u64vec2 sum=v[0];[[unroll]] for(int a=1;a<8;++a)sum+=v[a];
    [[unroll]] for(int w=0;w<8;++w)outputData.values[id*8+uint(w)]=0;
    outputData.values[id*8]=uint(sum.x);outputData.values[id*8+1]=uint(sum.x>>32);
    outputData.values[id*8+2]=uint(sum.y);outputData.values[id*8+3]=uint(sum.y>>32);
}
