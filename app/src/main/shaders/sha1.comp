#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#include "common/base.glsl"
uint rol(uint x,uint n){return (x<<n)|(x>>(32u-n));}
void compress(inout uvec4 h,inout uint he,uint w[16]){
    uint a=h.x,b=h.y,c=h.z,d=h.w,e=he;
    [[unroll]] for(int t=0;t<80;++t){
        if(t>=16)w[t&15]=rol(w[(t-3)&15]^w[(t-8)&15]^w[(t-14)&15]^w[t&15],1u);
        uint f=t<20?((b&c)|(~b&d)):t<40?(b^c^d):t<60?((b&c)|(b&d)|(c&d)):(b^c^d);
        uint k=t<20?0x5a827999u:t<40?0x6ed9eba1u:t<60?0x8f1bbcdcu:0xca62c1d6u;
        uint next=rol(a,5u)+f+e+k+w[t&15];e=d;d=c;c=rol(b,30u);b=a;a=next;
    }
    h+=uvec4(a,b,c,d);he+=e;
}
void main(){
    uint id=gl_GlobalInvocationID.x;if(id>=p.count)return;
    uint message=p.base+id;if(message>=p.span)return;
    // CPU 与 GPU 均处理 64 KiB 消息，再追加一个标准填充块。
    // CPU and GPU hash 64 KiB messages followed by one standard padding block.
    uvec4 h=uvec4(0x67452301u,0xefcdab89u,0x98badcfeu,0x10325476u);uint he=0xc3d2e1f0u;
    uint w[16];
    for(uint block=0u;block<1024u;++block){
        for(uint n=0u;n<16u;++n){
            uint x=inputData.values[(block*16u+n)*p.span+message];
            w[n]=((x&255u)<<24u)|((x&65280u)<<8u)|((x>>8u)&65280u)|(x>>24u);
        }
        compress(h,he,w);
    }
    for(int n=0;n<16;++n)w[n]=0u;
    w[0]=0x80000000u;w[15]=524288u;compress(h,he,w);
    for(uint n=0u;n<4u;++n)outputData.values[message*5u+n]=h[n];
    outputData.values[message*5u+4u]=he;
}
